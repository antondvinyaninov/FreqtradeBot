FROM freqtradeorg/freqtrade:stable

COPY --chown=ftuser:ftuser user_data/config.json /freqtrade/user_data/config.json
COPY --chown=ftuser:ftuser user_data/strategies/TrainingStrategy.py /freqtrade/user_data/strategies/TrainingStrategy.py

USER root
RUN pip install --no-cache-dir "psycopg[binary]" \
    && mkdir -p /freqtrade/user_data/logs \
    && chown -R ftuser:ftuser /freqtrade/user_data
USER ftuser

CMD ["trade", "--logfile", "/freqtrade/user_data/logs/freqtrade.log", "--config", "/freqtrade/user_data/config.json", "--strategy", "TrainingStrategy"]
